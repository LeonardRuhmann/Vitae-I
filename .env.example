# Vitae-I — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# The application reads these via os.environ.get() with sensible defaults.

# PostgreSQL (used by docker-compose AND SQLAlchemy)
POSTGRES_USER=vitae
POSTGRES_PASSWORD=vitae_secret
POSTGRES_DB=vitae_db

# Async database URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://vitae:vitae_secret@localhost:5432/vitae_db
